# Copy to .env and adjust. Used by docker-compose and (optionally) the backend.
POSTGRES_USER=lob
POSTGRES_PASSWORD=change_me
POSTGRES_DB=orderbook

# The backend reads DATABASE_URL directly. In docker-compose it is composed
# from the POSTGRES_* vars above; set it explicitly when running the backend
# outside compose (e.g. pointing at AWS RDS):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@your-rds-endpoint:5432/orderbook